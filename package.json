{
  "name": "@neil-jay/monorepo",
  "version": "0.1.0",
  "description": "Application Wiring Analyzer - Static verification of HTTP wiring in TypeScript applications",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "npm run build && node --test",
    "check:fixture": "npm run build && node packages/cli/dist/bin/awa.js check fixtures/smoke-pass --frontend src/frontend --backend src/backend",
    "clean": "npx tsc -b --clean tsconfig.json && node -e \"const{rmSync,readdirSync}=require('fs');['dist',...readdirSync('packages').map(p=>'packages/'+p+'/dist')].forEach(d=>rmSync(d,{recursive:true,force:true}))\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "typescript",
    "wiring",
    "analysis",
    "react",
    "hono",
    "http",
    "routing",
    "verification"
  ],
  "author": "PC-Mender",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC-Mender/application-wiring-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/PC-Mender/application-wiring-analyzer/issues"
  },
  "homepage": "https://github.com/PC-Mender/application-wiring-analyzer#readme"
}
